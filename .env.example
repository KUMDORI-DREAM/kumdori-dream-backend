ENVIRONMENT=development

# App DB connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://kumdori:kumdori@localhost:5432/kumdori_dream

# docker-compose postgres service
POSTGRES_USER=kumdori
POSTGRES_PASSWORD=kumdori
