DEF PATROL_ROBOT Robot {
  translation 0 0 0.08
  rotation 0 0 1 0
  children [
    DEF BODY Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.35 0.05
        roughness 0.6
        metalness 0.1
      }
      geometry Box {
        size 0.4 0.24 0.12
      }
    }
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
    DistanceSensor {
      name "front_distance_sensor"
      translation 0.5 0 0.12
      aperture 0.8
      lookupTable [
        0 1000 0
        2 0 0
      ]
    }
    DEF WHEEL_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.1 0.1
        roughness 1
        metalness 0
      }
      geometry Cylinder {
        height 0.04
        radius 0.08
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.15 0.14 0
      }
      device [
        RotationalMotor {
          name "front_left_motor"
        }
      ]
      endPoint Solid {
        translation 0.15 0.14 0
        rotation 1 0 0 1.5708
        children [
          USE WHEEL_SHAPE
        ]
        name "front_left_wheel"
        boundingObject USE WHEEL_SHAPE
        physics Physics {
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.15 -0.14 0
      }
      device [
        RotationalMotor {
          name "front_right_motor"
        }
      ]
      endPoint Solid {
        translation 0.15 -0.14 0
        rotation 1 0 0 1.5708
        children [
          USE WHEEL_SHAPE
        ]
        name "front_right_wheel"
        boundingObject USE WHEEL_SHAPE
        physics Physics {
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.15 0.14 0
      }
      device [
        RotationalMotor {
          name "rear_left_motor"
        }
      ]
      endPoint Solid {
        translation -0.15 0.14 0
        rotation 1 0 0 1.5708
        children [
          USE WHEEL_SHAPE
        ]
        name "rear_left_wheel"
        boundingObject USE WHEEL_SHAPE
        physics Physics {
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.15 -0.14 0
      }
      device [
        RotationalMotor {
          name "rear_right_motor"
        }
      ]
      endPoint Solid {
        translation -0.15 -0.14 0
        rotation 1 0 0 1.5708
        children [
          USE WHEEL_SHAPE
        ]
        name "rear_right_wheel"
        boundingObject USE WHEEL_SHAPE
        physics Physics {
        }
      }
    }
  ]
  name "warehouse-robot-01"
  boundingObject USE BODY
  physics Physics {
  }
  controller "warehouse_robot_controller"
}
