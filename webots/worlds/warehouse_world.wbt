#VRML_SIM R2025a utf8


WorldInfo {
  coordinateSystem "ENU"
  basicTimeStep 32
}
Viewpoint {
  orientation 0 0 1 0
  position 0 0 12
}
Background {
  skyColor [ 0.15 0.2 0.3 ]
}
DirectionalLight {
  direction -1 -1 -2
}
Solid {
  translation 0 0 -0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.65 0.65 0.65
        roughness 1
        metalness 0
      }
      geometry Box {
        size 8 8 0.1
      }
    }
  ]
  name "warehouse_floor"
  boundingObject Box {
    size 8 8 0.1
  }
}
Solid {
  translation 0 4 0.5
  children [ Shape { geometry Box { size 8 0.1 1 } } ]
  name "north_wall"
}
Solid {
  translation 0 -4 0.5
  children [ Shape { geometry Box { size 8 0.1 1 } } ]
  name "south_wall"
}
Solid {
  translation 4 0 0.5
  children [ Shape { geometry Box { size 0.1 8 1 } } ]
  name "east_wall"
}
Solid {
  translation -4 0 0.5
  children [ Shape { geometry Box { size 0.1 8 1 } } ]
  name "west_wall"
}

